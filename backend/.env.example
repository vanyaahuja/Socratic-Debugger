# Copy to backend/.env. Keep real credentials out of Git and frontend files.
# Obtain model IDs from your provider account; no model is selected by default.
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
# Optional for Gemini; normally leave empty. Required for openai_compatible.
LLM_PRIMARY_BASE_URL=

# Leave PROVIDER empty to disable backup. Enabling it permits sending the same
# problem/code/conversation to that provider; disclose this to your users.
# For Groq, use openai_compatible and https://api.groq.com/openai/v1
LLM_BACKUP_PROVIDER=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
LLM_BACKUP_BASE_URL=

# Entire generation (including retries/backup) is capped at 30 seconds.
LLM_TOTAL_TIMEOUT_SECONDS=30
LLM_ATTEMPT_TIMEOUT_SECONDS=8
# Includes the initial request: 2 means one initial request + one retry.
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=1024

# Existing GEMINI_API_KEY and GEMINI_MODEL are still accepted for the primary
# Gemini provider when the corresponding LLM_PRIMARY values are empty.
